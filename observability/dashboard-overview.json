{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus that scrapes the server's metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "VAR_AXIOM_ORG",
      "type": "constant",
      "label": "Axiom organization ID",
      "value": "",
      "description": "The ID in your Axiom URLs, as in app.axiom.co/<ID>/datasets"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
