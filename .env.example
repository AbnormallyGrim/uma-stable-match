# Copy to .env and fill in. Never commit .env.
UMAMOE_API_KEY=
# UMAMOE_BASE_URL=https://uma.moe
# HOST=127.0.0.1
# PORT=8080
# RUST_LOG=info
# LOG_FORMAT=text
# SCAN_RANK_FROM=80
# SCAN_RANK_TO=900
# SCAN_MAX_DETAILS=200
# SCAN_LOWER_RANK_TO=
# SCAN_INTERVAL_MINUTES=
# DETAIL_CACHE_MINUTES=
# DETAIL_CACHE_MB=256
# SHORTLIST_SIZE=120
# REQUEST_FETCH_BUDGET=10
# TRAINER_CACHE_MINUTES=10
# RATE_LIMIT_PER_MINUTE=30
# TRAINER_LOOKUPS_PER_MINUTE=10
# DISCORD_REQUESTS_PER_MINUTE=30
# DISCORD_SIGN_INS_PER_HOUR=10
# TRUST_FORWARDED_FOR=false
# ENABLE_JAPANESE=false
# ENABLE_APPLICATIONS=false
# FRONTEND_DIR=frontend/dist
# Optional: serve the website on this host name too, such as site.localhost to open it locally at
# http://site.localhost:8080. Both must be set together; with Docker Compose, SITE_DIR=/app/site.
# SITE_HOST=site.localhost
# SITE_DIR=site
# Optional: share caches with other instances through Redis. Both must be set together.
# With `docker compose --profile redis`, use REDIS_URL=redis://redis:6379.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_SECRET=at-least-32-characters-shared-by-every-instance
# Optional: club applications through Discord. All four together, and REDIS_URL, TOKEN_SIGNING_KEY
# (32+ characters, from `openssl rand -hex 32`) and PUBLIC_URL. Set the Interactions Endpoint URL
# in Discord's Developer Portal to https://<your host>/discord/interactions, and add
# <PUBLIC_URL>/api/v1/auth/discord/callback under OAuth2 Redirects.
# DISCORD_APP_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_SECRET=
# TOKEN_SIGNING_KEY=
# PUBLIC_URL=https://example.com
# Local only: a Discord server ID that takes every club's applications, so every ticket opens there.
# Refused unless PUBLIC_URL is http://localhost or http://127.0.0.1.
# DISCORD_DEV_GUILD=
# Optional: serve Prometheus metrics on this address only, never on the app's port.
# METRICS_ADDR=127.0.0.1:9464
# With Docker Compose, set this instead to publish metrics on this computer only.
# METRICS_PORT=9464
# Optional: comma-separated trainer IDs whose searches are left out of search metrics, such as your
# own test searches. Set it as a secret where you host the server; never commit real IDs.
# METRICS_EXCLUDED_TRAINER_IDS=111111111111,222222222222
# Optional: send traces over OTLP/HTTP. With Docker Compose, use http://host.docker.internal:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=
